---
import PageLayout from '../layouts/PageLayout.astro';

import GameCard from '../components/GameCard.astro';

import postboundImage from '../assets/images/games/postbound/capsule.png';
import adelkriegImage from '../assets/images/games/adelkrieg/capsule.png';

import company from '../data/company.json';
import postbound from '../data/games/postbound.json';
---

<PageLayout title='Games' description=`Games developed by ${company.name}.`>
	<Fragment slot="page-header">Games</Fragment>
	<article slot="page-content">
		<h2>Released</h2>
		<ul class="game-grid" role="list">
			<GameCard href="/games/postbound" title="Postbound!" image={postboundImage} body=`${postbound.name} is a 2D arcade-style mail sorting game following your journey as a novice postal worker.`/>
		</ul>
		<h2>Upcoming</h2>
		<ul class="game-grid" role="list">
			<GameCard href="https://adelkrieg.com" title="Adelkrieg" image={adelkriegImage} body=`Re-releases 2026. Adelkrieg is a conflict simulator that allows you to play out scenarios on a variety of maps.`/>
			<GameCard href="" title="Project Artemis" body=`Still under heavy development. Check back later this year!`/>
		</ul>
		<!--<h2>Released</h2>
		<p><i>Nothing yet.</i></p>-->
	</article>
</PageLayout>

<style lang="scss">
// Fits as many cards per row as the width allows (fixed grid columns overflowed when narrower than a card)
.game-grid {
	display: flex;
	flex-wrap: wrap;
	margin: 0;
	padding: 0;
}


p {
	margin-top: 0.5rem;
}
</style>