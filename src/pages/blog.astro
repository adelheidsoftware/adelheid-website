---
import { getCollection } from "astro:content";

import PageLayout from '../layouts/PageLayout.astro';
import BlogPostSummary from '../components/BlogPostSummary.astro';

import Pagination from '../components/Pagination.astro';

import { blogPaginationSize } from '../constants.ts';
import company from '../data/company.json';

const posts = await getCollection("posts", ({ data }) => import.meta.env.PROD ? !data.draft : true);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const postsToDisplay = posts.slice(0, blogPaginationSize);

const pageCount: number = Math.ceil(posts.length / blogPaginationSize);
---

<PageLayout title='Blog' description=`The official ${company.name} blog.`>
	<Fragment slot="page-header">Blog</Fragment>
	<article slot="page-content">
		<p class="tagline">Welcome to the {company.name} blog! You can find all of our blog posts on this page.</p>
		<div>
			<ul>
				{
					postsToDisplay.map((post) => (
						<BlogPostSummary href={`/blog/${post.id}`} title={post.data.title} summary={post.data.summary} date={post.data.pubDate} timeZone={post.data.timeZone} author={post.data.author} postText={post.body} />
						<li class="post-separator" aria-hidden="true"></li>
					))
				}
			</ul>
			<Pagination pageCount={pageCount} currentUrl="/blog" firstUrl="/blog" nextUrl="/blog/2"  lastUrl=`/blog/${pageCount}`/>
		</div>

	</article>
</PageLayout>

<style lang="scss">
ul {
	margin: 0;
	padding: 0;
}
.post-separator {
	border-bottom: 1px solid var(--color-outline);
	margin-left: 16px;
	margin-right: 16px;
	list-style: none;
	padding: 0 !important; // Overrides PageLayout's global list item padding
}
</style>